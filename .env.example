# Скопируйте в .env и заполните.

# 1) Токен бота-заказчика (его видят клиенты)
CLIENT_BOT_TOKEN=123456789:AA...

# 2) Токен бота-диспетчера (он сидит в чате водителей)
GROUP_BOT_TOKEN=987654321:BB...

# 3) ID чата водителей. Узнать: добавьте бота-диспетчера в чат и напишите /id
# Для супергруппы это число вида -1001234567890
GROUP_CHAT_ID=-1001234567890

# Через сколько минут автоматически отменять заказ, который никто не взял.
ORDER_TTL_MINUTES=30

# Код для входа в админку (/admin в личке любого бота). Пусто = админка выключена.
# Обязательно замените на свой.
ADMIN_CODE=change-me-admin-code

# Где хранить SQLite. В Docker внутри контейнера /data.
DATA_DIR=./data

# Обычно менять не нужно
API_BASE=https://api.telegram.org
TZ=Europe/Moscow
PYTHONUNBUFFERED=1
